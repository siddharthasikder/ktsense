    {
      "name": "trace_kotlin_symbol",
      "description": "Answers who uses one declaration: its definition, its implementors, the declarations that call it, and every reference site grouped by file. Prefer it over grep for who-calls and who-implements, which grep cannot separate from a definition. Every answer states index: complete or partial, and partial is a lower bound rather than the answer. requires: kmp-lsp and a settled index. cost: about 1.2 s on 1861 files (ktor 3.0.1, median of 9, KT-38).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "depth": {
            "description": "How many levels of callers to follow, 1 to 5; 1 is the declarations that refer to it.",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "description": "Show at most this many reference sites per file.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "pick": {
            "description": "Select the single candidate with this fully-qualified name when the name is ambiguous.",
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "description": "Workspace root to answer about; defaults to the server's configured root.",
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "description": "Declaration name to trace.",
            "type": "string"
