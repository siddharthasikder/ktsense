    {
      "name": "search_kotlin_text",
      "description": "Answers where a regex appears in the Kotlin and Java sources, grouping each hit under its file and the declaration it falls inside, labelled production or test, java when the file is Java, and code, comment or string. Named search_kotlin_text for compatibility, it covers .java as well as .kt/.kts; pass kotlin_only to search Kotlin alone. Prefer it over raw grep or trace when the subject is not one declaration: several terms at once (save|OrderId), a call-site pattern, or text in a file that nothing declares. The word, ignore_case and fixed_strings flags behave like rg's -w, -i and -F. It resolves nothing, so the answer states precision: text match and the hit count equals rg -c for the same pattern and flags over .kt, .kts and .java. requires: nothing. cost: about 720 ms on 1861 files (ktor 3.0.1, median of 9, KT-102).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "fixed_strings": {
            "description": "Treat the pattern as a literal string, not a regex, as `rg -F` does.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "ignore_case": {
            "description": "Match case-insensitively, as `rg -i` does.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "kotlin_only": {
            "description": "Search only Kotlin sources, leaving `.java` files out.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "limit": {
            "description": "Show at most this many hits per file; the rest are counted.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "path": {
            "description": "Restrict to files whose workspace-relative path starts with this prefix.",
            "type": [
              "string",
              "null"
            ]
          },
          "pattern": {
            "description": "Regular expression to search for in Kotlin and Java sources. Several concepts are an\nalternation, such as `save|OrderId`.",
            "type": "string"
          },
          "root": {
            "description": "Workspace root to answer about; defaults to the server's configured root.",
            "type": [
              "string",
              "null"
            ]
          },
          "tests": {
            "description": "Limit to test sources (true) or production sources (false); both when unset.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "word": {
            "description": "Match only whole words, bounding the pattern with word boundaries, as `rg -w` does.",
            "type": [
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Citation": {
            "description": "One place an answer points at.",
            "properties": {
              "column": {
                "description": "1-based column, present only where the answer stated one.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line": {
                "description": "1-based line.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "Path as the answer printed it: relative to the workspace root, `/`-separated.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "line"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "citations": {
            "description": "Every path and line the answer cites, deduplicated, in the order they appear.",
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
