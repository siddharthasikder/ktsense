    {
      "name": "explain_kotlin_symbol",
      "description": "Answers everything worth knowing about one symbol in a single budgeted bundle: its declaration, the outline of its file, its direct callers and its implementors, trimmed in that order of priority. Prefer it over calling find, outline and trace separately when you are orienting yourself around an unfamiliar symbol; reach for trace_kotlin_symbol instead when you need every reference site or callers deeper than one level. Pass only to restrict the bundle to specific sections (any of source, callers, implementors, outline) and spend the budget on them alone. Pass match with a regular expression to keep only the Source lines matching it, plus around context lines, so a question about one branch in a long body is answered from that declaration alone. An ambiguous name comes back as the candidate list; pass pick with one fully-qualified name to choose. Carries the same index: complete or partial marker a trace does. A name the workspace does not declare comes back with a Text references listing of where the name is written, marked precision: text match, rather than a bare failure. requires: kmp-lsp and a settled index. cost: about 1.1 s on 1861 files (ktor 3.0.1, median of 9, KT-34).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "around": {
            "description": "Context lines to keep on each side of a `match` hit; defaults to 1.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "budget": {
            "description": "Token budget for the bundle; defaults to 2000.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "match": {
            "description": "Show only the Source lines matching this regular expression, plus `around` context lines,\neach with its line number and `...` where lines were skipped.",
            "type": [
              "string",
              "null"
            ]
          },
          "only": {
            "default": [],
            "description": "Render only these sections (any of source, callers, implementors, outline) and spend the\nbudget on them alone; the declaration line is always shown. Omit for the full bundle.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "pick": {
            "description": "Select one candidate by full FQN or a unique dot-boundary suffix of one when the name is\nambiguous.",
            "type": [
              "string",
              "null"
            ]
          },
          "root": {
            "description": "Workspace root to answer about; defaults to the server's configured root.",
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "description": "Declaration name to explain; a dotted `Type.member` such as `OrderRepository.save` selects the\none candidate the whole name is a dot-suffix of. Optional when `pick` is given, in which case\nthe pick's last dot segment is the name.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Citation": {
            "description": "One place an answer points at.",
            "properties": {
              "column": {
                "description": "1-based column, present only where the answer stated one.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line": {
                "description": "1-based line.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "Path as the answer printed it: relative to the workspace root, `/`-separated.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "line"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "citations": {
            "description": "Every path and line the answer cites, deduplicated, in the order they appear.",
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
          },
          "citations_omitted": {
            "description": "How many further citations the text carries that this index does not, once the cap of 500\nis reached. The text is never truncated; only this index is.",
            "format": "uint",
