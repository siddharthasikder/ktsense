    {
      "name": "get_kotlin_outline",
      "description": "Answers what one Kotlin file declares: every signature with no bodies, public API only unless you ask for private. Prefer it over reading the file whenever you want the shape rather than the implementation; it is the cheapest tool here. requires: nothing. cost: about 30 ms on a 54 KB file (ktor 3.0.1, median of 9, KT-38).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "annotations": {
            "default": false,
            "description": "Show declaration annotations, hidden by default.",
            "type": "boolean"
          },
          "file": {
            "description": "Path to one Kotlin file, absolute or relative to the workspace root.",
            "type": "string"
          },
          "kdoc": {
            "default": false,
            "description": "Include the first line of each declaration's KDoc.",
            "type": "boolean"
          },
          "private": {
            "default": false,
            "description": "Include private and internal declarations, hidden by default.",
            "type": "boolean"
          },
          "root": {
            "description": "Workspace root to answer about; defaults to the server's configured root.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "file"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Citation": {
            "description": "One place an answer points at.",
            "properties": {
              "column": {
                "description": "1-based column, present only where the answer stated one.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line": {
                "description": "1-based line.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "Path as the answer printed it: relative to the workspace root, `/`-separated.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "line"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "citations": {
            "description": "Every path and line the answer cites, deduplicated, in the order they appear.",
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
          },
          "citations_omitted": {
            "description": "How many further citations the text carries that this index does not, once the cap of 500\nis reached. The text is never truncated; only this index is.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "command": {
            "description": "The `ktsense` subcommand it delegated to, so a human can reproduce the call.",
            "type": "string"
          },
          "exit": {
            "description": "The command's exit status, which is a contract to branch on: `0` an answer, `3` a name that\nresolved to several candidates and which one to use is yours to pick, `1` a failure on the\ninput, `2` a malformed invocation. Absent when the child was killed by a signal.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "files": {
            "description": "Files the answer is about, in the order it introduced them.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "findings": {
            "description": "How many distinct error sites a `check` answer cites: `0` when the file is clean, the count\nof cited positions when it is not, and absent when the check failed to run. It indexes the\nanswer the agent already reads rather than re-invoking the engine to count.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "index": {
            "description": "`complete` or `partial`, when the answer carried an index marker. `partial` means the list\nis a lower bound.",
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "description": "Whether the tool ran and answered or failed to run, as a machine-readable category: `clean`\nor `findings` for a `check` that ran, `execution_failure` for one that could not reach the\nengine. Set only where the exit status alone cannot separate an answer from a failure, which\ntoday is `check_kotlin_syntax`: its exit 1 means both \"found a syntax error\" and \"the engine\nis missing\", and an agent branching on `isError` has to be able to tell them apart.",
            "type": [
              "string",
              "null"
            ]
          },
          "requires": {
            "description": "What had to be installed for this call: `nothing`, `kmp-lsp`, or both engine and index.",
            "type": "string"
          },
          "root": {
            "description": "The workspace root the answer is about, which is what the cited paths are relative to.",
            "type": "string"
          },
          "tool": {
            "description": "The MCP tool name that produced this.",
            "type": "string"
          },
          "warmth": {
            "description": "What the server did about keeping an engine warm for this root: `opened`, `left_to_daemon`,\n`already_decided` or `failed`. Absent when the tool's answer does not depend on the index, or\nwhen warming is switched off.\n\nThis is a fact about the server's own action and never a claim about the engine's index, which\nthe commands that carry an `index:` marker state for themselves. It is reported because\n`find_kotlin_symbol` carries no such marker and its answer is shaped by the index anyway:\nagainst a cold one the engine text-searches, and one declaration can arrive as several\ncandidates that look like a genuine ambiguity. A `failed` here is the reason to distrust a\nduplicated-looking result and to call `ktsense_status`.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "command",
          "requires",
          "root",
          "files",
          "citations",
          "citations_omitted"
        ],
        "type": "object"
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_kotlin_repo_map",
      "description": "Answers what a repository is: its most central files first with their signatures, packed into a token budget. Start here on an unfamiliar repository, before reaching for any file-level tool. Pass compact to list each file's declarations as kind and name only, no signatures, so the same budget covers far more of the module. Pass focus with a regex to list the declarations whose name matches it first, grouped by file, and stop there; focus implies compact. Add fill to then spend the rest of the budget on the ranked map, as a map without a focus does. Pass path to map only files whose workspace-relative path contains a substring, repeatable for several (a file is kept if it matches any); the header then states how many of the files the filter kept. Test sources are excluded and ranking is by import centrality, which is syntactic. requires: nothing. cost: about 1.1 s on 1861 files (ktor 3.0.1, median of 9, KT-38), so call it once and keep the answer instead of re-asking.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "budget": {
            "description": "Token budget for the map; defaults to 4000.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "compact": {
            "default": false,
            "description": "List each file's public declarations as kind and name only, no signatures, so the same\nbudget covers more of the module.",
            "type": "boolean"
          },
          "fill": {
            "default": false,
            "description": "With focus, spend what budget the focus section leaves on the ranked map, as a map without a\nfocus does. Without it a focused map renders the focus section and stops. Requires focus.",
            "type": "boolean"
          },
          "focus": {
            "description": "List declarations whose name matches this regex first, grouped by file, and stop there\nunless fill is set. Implies compact.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "default": [],
            "description": "Map only files whose workspace-relative path contains a substring; repeat for several (a file\nis kept if it matches any). Composes with compact, focus and fill.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "root": {
            "description": "Workspace root to answer about; defaults to the server's configured root.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "Citation": {
            "description": "One place an answer points at.",
            "properties": {
              "column": {
                "description": "1-based column, present only where the answer stated one.",
                "format": "uint32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "line": {
                "description": "1-based line.",
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "path": {
                "description": "Path as the answer printed it: relative to the workspace root, `/`-separated.",
                "type": "string"
              }
            },
            "required": [
              "path",
              "line"
            ],
            "type": "object"
          }
        },
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "citations": {
            "description": "Every path and line the answer cites, deduplicated, in the order they appear.",
            "items": {
              "$ref": "#/$defs/Citation"
            },
            "type": "array"
          },
          "citations_omitted": {
            "description": "How many further citations the text carries that this index does not, once the cap of 500\nis reached. The text is never truncated; only this index is.",
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "command": {
            "description": "The `ktsense` subcommand it delegated to, so a human can reproduce the call.",
            "type": "string"
          },
          "exit": {
            "description": "The command's exit status, which is a contract to branch on: `0` an answer, `3` a name that\nresolved to several candidates and which one to use is yours to pick, `1` a failure on the\ninput, `2` a malformed invocation. Absent when the child was killed by a signal.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "files": {
            "description": "Files the answer is about, in the order it introduced them.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "findings": {
            "description": "How many distinct error sites a `check` answer cites: `0` when the file is clean, the count\nof cited positions when it is not, and absent when the check failed to run. It indexes the\nanswer the agent already reads rather than re-invoking the engine to count.",
            "format": "uint",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "index": {
            "description": "`complete` or `partial`, when the answer carried an index marker. `partial` means the list\nis a lower bound.",
            "type": [
