class Validator<T> where T : Any {
    fun validate(candidate: T, rules: List<(T) -> ValidationError?>): List<ValidationError>
    fun combine(first: (T) -> ValidationError?, second: (T) -> ValidationError?): (T) -> ValidationError?
    fun validateAllReturningVeryLongTypeName(candidates: Collection<T>, stopOnFirstFailure: Boolean = false): Map<T, List<ValidationError>>
